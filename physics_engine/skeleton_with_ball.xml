<?xml version="1.0" encoding="utf-8"?>
<mujoco model="skeleton_basketball">
    <!--
    Basketball with Skeleton Trajectory

    This model includes key body parts from the skeleton data.
    The trajectory will be baked into keyframes from actual shot data.
    -->

    <option gravity="0 0 -9.81" timestep="0.002"/>

    <visual>
        <global offwidth="1920" offheight="1080"/>
        <quality shadowsize="4096"/>
        <headlight ambient="0.4 0.4 0.4" diffuse="0.8 0.8 0.8"/>
    </visual>

    <asset>
        <material name="court" rgba="0.76 0.60 0.42 1" specular="0.1"/>
        <material name="ball" rgba="1 0.5 0 1" specular="0.3"/>
        <material name="body" rgba="0.2 0.6 0.9 1"/>
        <material name="hand" rgba="0.85 0.7 0.55 1"/>
        <material name="rim" rgba="1 0.3 0 1" specular="0.8"/>
    </asset>

    <worldbody>
        <light pos="0 0 10" dir="0 0 -1" diffuse="1 1 1"/>

        <!-- Court -->
        <geom name="court" type="plane" size="15 15 0.1" material="court"/>

        <!-- Hoop (15 feet from typical player position) -->
        <body name="hoop" pos="1.5 -7.6 3.05">
            <geom name="rim" type="cylinder" size="0.229 0.015" material="rim"/>
            <geom name="backboard" type="box" pos="-0.15 0 0.45" size="0.02 0.91 0.61" rgba="1 1 1 0.8"/>
            <geom name="pole" type="cylinder" pos="-0.4 0 -1.5" size="0.08 1.5" rgba="0.3 0.3 0.3 1"/>
        </body>

        <!-- SKELETON: Torso (root) -->
        <body name="torso" pos="5.7 -7.6 1.0">
            <joint name="torso_x" type="slide" axis="1 0 0"/>
            <joint name="torso_y" type="slide" axis="0 1 0"/>
            <joint name="torso_z" type="slide" axis="0 0 1"/>
            <geom name="torso_geom" type="capsule" size="0.15" fromto="0 0 0 0 0 0.5" material="body"/>

            <!-- Head -->
            <body name="head" pos="0 0 0.6">
                <geom name="head_geom" type="sphere" size="0.12" material="body"/>
            </body>

            <!-- Right shoulder -->
            <body name="right_shoulder" pos="0.2 0 0.4">
                <joint name="rshoulder_x" type="slide" axis="1 0 0"/>
                <joint name="rshoulder_y" type="slide" axis="0 1 0"/>
                <joint name="rshoulder_z" type="slide" axis="0 0 1"/>
                <geom name="rshoulder_geom" type="sphere" size="0.06" material="body"/>

                <!-- Right elbow -->
                <body name="right_elbow" pos="0.15 0 -0.15">
                    <joint name="relbow_x" type="slide" axis="1 0 0"/>
                    <joint name="relbow_y" type="slide" axis="0 1 0"/>
                    <joint name="relbow_z" type="slide" axis="0 0 1"/>
                    <geom name="rupperarm" type="capsule" size="0.04" fromto="-0.15 0 0.15 0 0 0" material="body"/>
                    <geom name="relbow_geom" type="sphere" size="0.05" material="body"/>

                    <!-- Right wrist -->
                    <body name="right_wrist" pos="0.1 0 -0.15">
                        <joint name="rwrist_x" type="slide" axis="1 0 0"/>
                        <joint name="rwrist_y" type="slide" axis="0 1 0"/>
                        <joint name="rwrist_z" type="slide" axis="0 0 1"/>
                        <geom name="rforearm" type="capsule" size="0.035" fromto="-0.1 0 0.15 0 0 0" material="body"/>
                        <geom name="rwrist_geom" type="sphere" size="0.04" material="hand"/>

                        <!-- Right hand/fingers -->
                        <body name="right_hand" pos="0.05 0 -0.05">
                            <joint name="rhand_x" type="slide" axis="1 0 0"/>
                            <joint name="rhand_y" type="slide" axis="0 1 0"/>
                            <joint name="rhand_z" type="slide" axis="0 0 1"/>
                            <geom name="rhand_geom" type="cylinder" size="0.08 0.015" material="hand"/>
                        </body>
                    </body>
                </body>
            </body>

            <!-- Left shoulder (guide hand) -->
            <body name="left_shoulder" pos="-0.2 0 0.4">
                <joint name="lshoulder_x" type="slide" axis="1 0 0"/>
                <joint name="lshoulder_y" type="slide" axis="0 1 0"/>
                <joint name="lshoulder_z" type="slide" axis="0 0 1"/>
                <geom name="lshoulder_geom" type="sphere" size="0.06" material="body"/>

                <body name="left_elbow" pos="-0.15 0 -0.15">
                    <joint name="lelbow_x" type="slide" axis="1 0 0"/>
                    <joint name="lelbow_y" type="slide" axis="0 1 0"/>
                    <joint name="lelbow_z" type="slide" axis="0 0 1"/>
                    <geom name="lupperarm" type="capsule" size="0.04" fromto="0.15 0 0.15 0 0 0" material="body"/>
                    <geom name="lelbow_geom" type="sphere" size="0.05" material="body"/>

                    <body name="left_wrist" pos="-0.1 0 -0.15">
                        <joint name="lwrist_x" type="slide" axis="1 0 0"/>
                        <joint name="lwrist_y" type="slide" axis="0 1 0"/>
                        <joint name="lwrist_z" type="slide" axis="0 0 1"/>
                        <geom name="lforearm" type="capsule" size="0.035" fromto="0.1 0 0.15 0 0 0" material="body"/>
                        <geom name="lwrist_geom" type="sphere" size="0.04" material="hand"/>
                    </body>
                </body>
            </body>
        </body>

        <!-- Basketball (free body) -->
        <body name="ball" pos="5.9 -7.6 1.9">
            <freejoint name="ball_free"/>
            <geom name="basketball" type="sphere" size="0.12" material="ball" mass="0.625"/>
        </body>

    </worldbody>

</mujoco>
